{
  "name": "littlehype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "wrangler dev --env staging",
    "dev:web": "npm run dev --workspace web",
    "build:web": "npm run build --workspace web",
    "deploy:staging": "npm run predeploy -- staging && npm run build:web && wrangler deploy --env staging",
    "deploy:production": "npm run predeploy -- production && npm run build:web && wrangler deploy --env production",
    "predeploy": "bash scripts/check-deploy-config.sh",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace web",
    "lint": "npm run lint --workspace web",
    "test": "vitest run --exclude 'test/integration/**' && npm run test --workspace web",
    "test:integration": "vitest run test/integration --no-file-parallelism"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.6",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
